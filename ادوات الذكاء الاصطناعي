    const freeGrid = document.getElementById("freeGrid");
    const paidGrid = document.getElementById("paidGrid");
    const searchInput = document.getElementById("searchInput");
    const clearBtn = document.getElementById("clearSearch");
    const emptyState = document.getElementById("emptyState");

    let selectedCategory = "all";


    function createCard(tool) {

      const typeText = tool.type === "free"
        ? "مجاني"
        : "Pro";

      const typeClass = tool.type === "free"
        ? "free"
        : "paid";

      return `
        <article
          class="tool-card"
          data-name="${tool.name.toLowerCase()}"
          data-category="${tool.category.join(" ")}"
        >

          <div class="tool-top">

            <div class="tool-logo">
              ${tool.icon}
            </div>

            <span class="availability ${typeClass}">
              ${typeText}
            </span>

          </div>

          <h3>${tool.name}</h3>

          <p class="description">
            ${tool.description}
          </p>

          <div class="tags">
            ${tool.tags.map(tag => `<span class="tag">${tag}</span>`).join("")}
          </div>

          <a
            class="open-btn"
            href="${tool.url}"
            target="_blank"
            rel="noopener noreferrer"
          >
            فتح الأداة
            <span>↗</span>
          </a>

        </article>
      `;
    }


    function renderTools() {

      const freeTools = tools.filter(tool => tool.type === "free");
      const paidTools = tools.filter(tool => tool.type === "paid");

      freeGrid.innerHTML = freeTools.map(createCard).join("");
      paidGrid.innerHTML = paidTools.map(createCard).join("");

      filterTools();

    }


    function filterTools() {

      const query = searchInput.value.trim().toLowerCase();

      const cards = document.querySelectorAll(".tool-card");

      let visibleCount = 0;

      cards.forEach(card => {

        const name = card.dataset.name;
        const categories = card.dataset.category;

        const matchesSearch =
          !query ||
          name.includes(query) ||
          categories.includes(query);

        const matchesCategory =
          selectedCategory === "all" ||
          categories.includes(selectedCategory);

        const show = matchesSearch && matchesCategory;

        card.style.display = show ? "flex" : "none";

        if (show) {
          visibleCount++;
        }

      });

      emptyState.classList.toggle("show", visibleCount === 0);

      clearBtn.classList.toggle(
        "show",
        searchInput.value.length > 0
      );

    }


    searchInput.addEventListener("input", filterTools);


    function clearSearch() {

      searchInput.value = "";
      selectedCategory = "all";

      document.querySelectorAll(".category-btn").forEach(btn => {
        btn.classList.remove("active");

        if (btn.dataset.category === "all") {
          btn.classList.add("active");
        }
      });

      filterTools();
      searchInput.focus();

    }


    document.querySelectorAll(".category-btn").forEach(button => {

      button.addEventListener("click", () => {

        document.querySelectorAll(".category-btn")
          .forEach(btn => btn.classList.remove("active"));

        button.classList.add("active");

        selectedCategory = button.dataset.category;

        filterTools();

      });

    });


    function scrollToSection(section) {

      if (section === "all") {
        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
        return;
      }

      const element = document.getElementById(section);

      if (element) {
        element.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }

    }


    renderTools();

  </script>

