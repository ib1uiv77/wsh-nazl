<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AI Hub | دليل أدوات الذكاء الاصطناعي</title>
  <meta name="description" content="AI Hub - اكتشف أفضل أدوات الذكاء الاصطناعي المجانية والمدفوعة في مكان واحد.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #061018;
      --bg-2: #091923;
      --card: rgba(13, 31, 43, .82);
      --card-hover: #102c3b;
      --text: #f5fbff;
      --muted: #91abb7;
      --cyan: #00dcff;
      --cyan-2: #00a8c7;
      --gold: #ffd447;
      --green: #42e6a4;
      --purple: #9b7cff;
      --line: rgba(255,255,255,.09);
      --shadow: 0 20px 60px rgba(0,0,0,.3);
      --radius: 22px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 15% 10%, rgba(0,220,255,.13), transparent 28%),
        radial-gradient(circle at 85% 15%, rgba(255,212,71,.10), transparent 25%),
        linear-gradient(145deg, var(--bg), var(--bg-2));
      color: var(--text);
      font-family: "Tajawal", sans-serif;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(rgba(255,255,255,.015) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.015) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: linear-gradient(to bottom, black, transparent 80%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input {
      font: inherit;
    }

    .container {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
    }

    /* HEADER */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid var(--line);
      background: rgba(6,16,24,.78);
      backdrop-filter: blur(20px);
    }

    .nav {
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 900;
      font-size: 22px;
      white-space: nowrap;
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--cyan), #087e9b);
      box-shadow: 0 0 28px rgba(0,220,255,.2);
      font-size: 21px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-links button {
      border: 0;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      padding: 10px 13px;
      border-radius: 12px;
      transition: .2s;
    }

    .nav-links button:hover,
    .nav-links button.active {
      color: var(--text);
      background: rgba(255,255,255,.06);
    }

    .pro-button {
      border: 1px solid rgba(255,212,71,.35) !important;
      color: var(--gold) !important;
    }

    /* HERO */
    .hero {
      text-align: center;
      padding: 82px 0 45px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border: 1px solid rgba(0,220,255,.2);
      background: rgba(0,220,255,.06);
      color: var(--cyan);
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(38px, 7vw, 72px);
      line-height: 1.05;
      font-weight: 900;
      letter-spacing: -2px;
    }

    .hero h1 span {
      color: var(--cyan);
      text-shadow: 0 0 35px rgba(0,220,255,.22);
    }

    .hero p {
      max-width: 680px;
      margin: 22px auto 30px;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.9;
    }

    /* SEARCH */
    .search-wrap {
      max-width: 760px;
      margin: 0 auto;
      position: relative;
    }

    .search-box {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 66px;
      padding: 8px 19px;
      border: 1px solid rgba(0,220,255,.25);
      background: rgba(9,29,40,.9);
      border-radius: 20px;
      box-shadow:
        0 0 0 5px rgba(0,220,255,.025),
        0 20px 55px rgba(0,0,0,.25);
      transition: .25s;
    }

    .search-box:focus-within {
      border-color: rgba(0,220,255,.65);
      box-shadow:
        0 0 0 5px rgba(0,220,255,.07),
        0 20px 60px rgba(0,0,0,.3);
    }

    .search-icon {
      color: var(--cyan);
      font-size: 22px;
      flex: 0 0 auto;
    }

    #searchInput {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      font-size: 16px;
    }

    #searchInput::placeholder {
      color: #6f8995;
    }

    .clear-search {
      display: none;
      border: 0;
      background: rgba(255,255,255,.07);
      color: var(--muted);
      width: 34px;
      height: 34px;
      border-radius: 10px;
      cursor: pointer;
    }

    .clear-search.show {
      display: block;
    }

    /* CATEGORIES */
    .categories {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 9px;
      margin: 27px 0 50px;
    }

    .category-btn {
      border: 1px solid var(--line);
      background: rgba(255,255,255,.035);
      color: var(--muted);
      padding: 10px 15px;
      border-radius: 999px;
      cursor: pointer;
      transition: .2s;
      font-size: 13px;
      font-weight: 700;
    }

    .category-btn:hover,
    .category-btn.active {
      color: #00141b;
      background: var(--cyan);
      border-color: var(--cyan);
    }

    /* SECTION */
    .section {
      padding: 15px 0 55px;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .section-title h2 {
      font-size: 25px;
      font-weight: 900;
    }

    .section-title p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 5px;
    }

    .section-badge {
      padding: 7px 11px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 800;
    }

    .free-badge {
      color: var(--green);
      background: rgba(66,230,164,.08);
      border: 1px solid rgba(66,230,164,.2);
    }

    .paid-badge {
      color: var(--gold);
      background: rgba(255,212,71,.08);
      border: 1px solid rgba(255,212,71,.2);
    }

    /* GRID */
    .tools-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .tool-card {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 250px;
      padding: 20px;
      background: linear-gradient(145deg, rgba(15,37,50,.9), rgba(8,25,35,.88));
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      transition: transform .25s, border-color .25s, box-shadow .25s;
    }

    .tool-card::after {
      content: "";
      position: absolute;
      width: 130px;
      height: 130px;
      top: -65px;
      left: -65px;
      border-radius: 50%;
      background: var(--cyan);
      opacity: .035;
      pointer-events: none;
    }

    .tool-card:hover {
      transform: translateY(-5px);
      border-color: rgba(0,220,255,.3);
      box-shadow: 0 18px 45px rgba(0,0,0,.25);
    }

    .tool-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }

    .tool-logo {
      width: 55px;
      height: 55px;
      display: grid;
      place-items: center;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(0,220,255,.14), rgba(255,255,255,.05));
      border: 1px solid rgba(255,255,255,.07);
      font-size: 27px;
    }

    .availability {
      font-size: 10px;
      font-weight: 800;
      padding: 6px 9px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .availability.free {
      color: var(--green);
      background: rgba(66,230,164,.08);
    }

    .availability.paid {
      color: var(--gold);
      background: rgba(255,212,71,.08);
    }

    .tool-card h3 {
      margin-top: 17px;
      font-size: 18px;
      font-weight: 900;
    }

    .tool-card .description {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.8;
      min-height: 47px;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 13px;
    }

    .tag {
      color: #8eabb7;
      font-size: 10px;
      padding: 5px 8px;
      border-radius: 7px;
      background: rgba(255,255,255,.045);
    }

    .open-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      width: 100%;
      margin-top: auto;
      padding: 11px 13px;
      border-radius: 12px;
      background: rgba(0,220,255,.09);
      border: 1px solid rgba(0,220,255,.15);
      color: var(--cyan);
      font-size: 12px;
      font-weight: 800;
      transition: .2s;
    }

    .open-btn:hover {
      background: var(--cyan);
      color: #00141a;
    }

    /* EMPTY */
    .empty {
      display: none;
      text-align: center;
      padding: 60px 20px;
      border: 1px dashed var(--line);
      border-radius: 20px;
      color: var(--muted);
    }

    .empty.show {
      display: block;
    }

    .empty-icon {
      font-size: 40px;
      margin-bottom: 10px;
    }

    /* CTA */
    .cta {
      margin: 20px 0 70px;
      padding: 35px;
      text-align: center;
      border: 1px solid rgba(255,212,71,.15);
      border-radius: 28px;
      background:
        radial-gradient(circle at center, rgba(255,212,71,.08), transparent 55%),
        rgba(255,255,255,.025);
    }

    .cta h2 {
      font-size: 26px;
      font-weight: 900;
    }

    .cta p {
      margin-top: 9px;
      color: var(--muted);
      font-size: 14px;
    }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--line);
      padding: 28px 0;
      color: var(--muted);
      font-size: 12px;
      text-align: center;
    }

    footer strong {
      color: var(--cyan);
    }

    /* MOBILE */
    @media (max-width: 950px) {
      .tools-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 720px) {
      .nav-links {
        display: none;
      }

      .hero {
        padding-top: 55px;
      }

      .tools-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .tool-card {
        min-height: 245px;
      }

      .section-heading {
        align-items: center;
      }
    }

    @media (max-width: 480px) {
      .container {
        width: min(100% - 22px, 1180px);
      }

      .hero h1 {
        font-size: 40px;
      }

      .hero p {
        font-size: 14px;
      }

      .tools-grid {
        grid-template-columns: 1fr;
      }

      .tool-card {
        min-height: 220px;
      }

      .categories {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 5px;
      }

      .category-btn {
        flex: 0 0 auto;
      }
    }
  </style>
</head>

